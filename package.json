{
  "name": "@open-athena/auth",
  "version": "0.1.0",
  "description": "Named share links, SSO, and an access log for gated dashboards.",
  "license": "MIT",
  "repository": "github:Open-Athena/auth",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "files": [
    "dist",
    "migrations",
    "schema.sql",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/adapters/d1.d.ts",
      "default": "./dist/adapters/d1.js"
    },
    "./resend": {
      "types": "./dist/adapters/resend.d.ts",
      "default": "./dist/adapters/resend.js"
    },
    "./oidc": {
      "types": "./dist/adapters/oidc.d.ts",
      "default": "./dist/adapters/oidc.js"
    },
    "./cf-access": {
      "types": "./dist/adapters/cf-access.d.ts",
      "default": "./dist/adapters/cf-access.js"
    },
    "./r2": {
      "types": "./dist/adapters/r2.d.ts",
      "default": "./dist/adapters/r2.js"
    },
    "./google-directory": {
      "types": "./dist/adapters/google-directory.d.ts",
      "default": "./dist/adapters/google-directory.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./schema.sql": "./schema.sql",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.react.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node scripts/gen-schema.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
