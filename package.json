    "@cloudflare/workers-types": "*",
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
