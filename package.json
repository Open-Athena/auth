{
  "name": "@open-athena/auth",
  "version": "0.1.0-dist.c35d945",
  "description": "Named share links, SSO, and an access log for gated dashboards.",
  "license": "MIT",
  "repository": "github:Open-Athena/auth",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/adapters/d1.d.ts",
      "default": "./dist/adapters/d1.js"
    },
    "./cf-access": {
      "types": "./dist/adapters/cf-access.d.ts",
      "default": "./dist/adapters/cf-access.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
