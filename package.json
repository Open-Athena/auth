      "types": "./dist/client/session-log/index.d.ts",
      "default": "./dist/client/session-log/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/user-menu": {
      "types": "./dist/react/UserMenu.d.ts",
      "default": "./dist/react/UserMenu.js"
    },
    "./react/mount": {
      "types": "./dist/react/mount.d.ts",
      "default": "./dist/react/mount.js"
    },
    "./react/ui.css": "./dist/react/ui.css",
    "./react/session-log": {
      "types": "./dist/react/session-log/index.d.ts",
