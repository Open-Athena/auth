{
  "name": "@open-athena/auth",
  "version": "0.1.0",
  "description": "Named share links, SSO, and an access log for gated dashboards.",
  "license": "MIT",
  "repository": "github:Open-Athena/auth",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "files": [
    "dist",
    "migrations",
    "src"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/adapters/d1.d.ts",
      "default": "./dist/adapters/d1.js"
    },
    "./resend": {
      "types": "./dist/adapters/resend.d.ts",
      "default": "./dist/adapters/resend.js"
    },
    "./oidc": {
      "types": "./dist/adapters/oidc.d.ts",
      "default": "./dist/adapters/oidc.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./provider/d1": {
      "types": "./dist/adapters/d1-provider.d.ts",
      "default": "./dist/adapters/d1-provider.js"
    },
    "./r2": {
      "types": "./dist/adapters/r2.d.ts",
      "default": "./dist/adapters/r2.js"
    },
    "./google-directory": {
      "types": "./dist/adapters/google-directory.d.ts",
      "default": "./dist/adapters/google-directory.js"
    },
    "./session-log": {
      "types": "./dist/session-log/index.d.ts",
      "default": "./dist/session-log/index.js"
    },
    "./session-log/d1": {
      "types": "./dist/adapters/d1-session-log.d.ts",
      "default": "./dist/adapters/d1-session-log.js"
    },
    "./session-log/client": {
      "types": "./dist/client/session-log/index.d.ts",
      "default": "./dist/client/session-log/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/session-log": {
      "types": "./dist/react/session-log/index.d.ts",
      "default": "./dist/react/session-log/index.js"
    },
    "./react/session-log.css": "./dist/react/session-log/session-log.css",
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.client.json && tsc -p tsconfig.build.react.json && tsc -p tsconfig.build.vue.json && cp src/react/session-log/session-log.css dist/react/session-log/ && node scripts/verify-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.vue.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:retained-runtime": "OA_D1_RUNTIME=1 vitest run test/d1-retained.test.ts",
    "test:browser": "pnpm --filter @open-athena/auth-demo build && playwright test",
    "test:browser:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
