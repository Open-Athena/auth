{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@open-athena/auth": ["./src/index.ts"],
      "@open-athena/auth/d1": ["./src/adapters/d1.ts"],
      "@open-athena/auth/oidc": ["./src/adapters/oidc.ts"],
      "@open-athena/auth/provider": ["./src/provider/index.ts"],
      "@open-athena/auth/provider/d1": ["./src/adapters/d1-provider.ts"]
    },
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "declaration": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // `src/react` and `test/react` are compiled by tsconfig.react.json instead —
  // see the note there.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["src/react/**/*", "src/client/**/*", "src/vue/**/*", "test/vue*.ts", "test/react/**/*", "test/client*.ts"]
}
